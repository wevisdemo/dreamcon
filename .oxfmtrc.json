{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 80,
  "tabWidth": 2,
  "jsxSingleQuote": false,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "sortPackageJson": false,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react/**", "react-dom", "react-dom/**"]
      }
    ],
    "groups": [
      "react",
      "builtin",
      "external",
      ["parent", "sibling", "index"],
      "unknown"
    ],
    "newlinesBetween": false
  },
  "overrides": [
    {
      "files": ["editor/**"],
      "options": {
        "sortTailwindcss": { "stylesheet": "./editor/src/App.css" }
      }
    },
    {
      "files": ["explorer/**"],
      "options": {
        "sortTailwindcss": { "stylesheet": "./explorer/src/styles.css" }
      }
    }
  ],
  "ignorePatterns": ["pnpm-lock.yaml", "explorer/src/routeTree.gen.ts"]
}
