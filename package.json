{
  "name": "dreamcon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dreamcon/explorer dev",
    "build": "pnpm -r build && rm -rf dist && cp -r explorer/dist/client dist && cp -r editor/dist dist/editor",
    "test": "pnpm -r test",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0"
  }
}
