rules_version = '2';

// Mirror of the production rules managed in the Firebase console.
// Not deployed by anything in this repo; keep in sync by hand.
//
// Writers are identified by a cookie, not by Firebase Auth, so these rules
// cannot tell *which* event joins or leaves a topic or comment - only that at
// most one id changes at a time. The remaining guards ("you still have replies
// here", "edit or delete only when a single event is linked") need a query over
// comments and stay client-side in usePermission.canManage.

// A topic or comment may gain or lose exactly one event per update, and never end up empty.
// Docs that predate the field read as an empty list, so they follow the same rule.
function isEventIdsValid() {
  let oldIds = resource.data.get('event_ids', []).toSet();
  let newIds = request.resource.data.get('event_ids', []).toSet();
  return oldIds == newIds
    || (newIds.size() == oldIds.size() + 1 && newIds.hasAll(oldIds))
    || (oldIds.size() == newIds.size() + 1 && oldIds.hasAll(newIds) && newIds.size() > 0)
}
service cloud.firestore {
  match /databases/{database}/documents {
    match /writers/{docId} {
      allow write: if request.auth != null;
      allow read: if true;
    }

    match /events/{docId} {
      allow write: if true;
      allow read: if true;
    }

    match /comments/{docId} {
      allow update: if isEventIdsValid();
      allow read, create, delete: if true;
    }

    match /topics/{docId} {
      allow update: if isEventIdsValid();
      allow read, create, delete: if true;
    }
  }
}
